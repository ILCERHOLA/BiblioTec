<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <persistence-unit name="bibliotecPU" transaction-type="RESOURCE_LOCAL">
    <class>pe.bibliotec.model.Categoria</class>
    <class>pe.bibliotec.model.Autor</class>
    <class>pe.bibliotec.model.Libro</class>
    <class>pe.bibliotec.model.Ejemplar</class>
    <class>pe.bibliotec.model.EstadoEjemplarConverter</class>
    <class>pe.bibliotec.model.Usuario</class>
    <class>pe.bibliotec.model.RolConverter</class>
    <class>pe.bibliotec.model.EstadoUsuarioConverter</class>
    <class>pe.bibliotec.model.EstadoPrestamoConverter</class>
    <class>pe.bibliotec.model.EstadoMultaConverter</class>
    <class>pe.bibliotec.model.Prestamo</class>
    <class>pe.bibliotec.model.Multa</class>
    <class>pe.bibliotec.model.EstadoReservaConverter</class>
    <class>pe.bibliotec.model.Reserva</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="hibernate.hikari.maximumPoolSize" value="10"/>
      <property name="hibernate.hikari.minimumIdle" value="2"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
    </properties>
  </persistence-unit>
</persistence>